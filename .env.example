# Copy to .env.local and adjust. Restart `npm run dev` after changing.

# Backend API base URL (defaults to this when unset).
VITE_API_BASE_URL=http://localhost:8080/api

# true = the Sprint 2 provider pages use in-browser mocks (src/services/sprint2Mocks.js)
# instead of endpoints that don't exist yet. A "Mocks" button in the bottom-left
# corner picks which response each call returns (success, 400, 403, network error...).
VITE_USE_MOCKS=true
