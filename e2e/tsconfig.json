{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "playwright.test-plan.config.ts",
    "global-setup.ts",
    "helpers/**/*.ts",
    "tests/**/*.ts"
  ]
}
